# Copy to .env for local use. Never commit .env. In production, set these as platform secrets.

# --- Storage ---------------------------------------------------------------
# SQLite for development (ADR-0001); PostgreSQL (Neon) in production.
RSF_DATABASE_URL=sqlite:///var/rsf.db
# RSF_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Evidence blobs: file://<dir>, memory://, or s3://<bucket> (Cloudflare R2 in production).
RSF_BLOB_STORE=file://var/blobs
# RSF_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# RSF_S3_ACCESS_KEY_ID=
# RSF_S3_SECRET_ACCESS_KEY=

# --- Judgment steps ----------------------------------------------------------
# rules = deterministic, offline, free. anthropic = Claude (needs ANTHROPIC_API_KEY).
RSF_MODEL_PROVIDER=rules
RSF_ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# Model-spend caps (ADR-0006). Nested settings use a double underscore.
RSF_BUDGETS__MAX_COST_USD_PER_RUN=1.00
RSF_BUDGETS__MAX_COST_USD_PER_DAY=10.00
RSF_BUDGETS__MAX_GUEST_LIVE_RUNS_PER_DAY=3

# --- SEC EDGAR (only for rebuilding the universe snapshot) --------------------
# SEC fair access requires "<organization> <contact email>".
# RSF_SEC_USER_AGENT="Your Name your.address@example.com"

# --- HTTP serving ------------------------------------------------------------
RSF_HTTP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
RSF_HTTP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
RSF_GUEST_REQUESTS_PER_MINUTE=30
RSF_LOG_LEVEL=INFO
